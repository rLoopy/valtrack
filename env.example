# Token du bot Discord (obtenez-le sur https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Clé API Valorant (déjà fournie)
VALORANT_API_KEY=HDEV-c797c6bf-6699-49b0-9bc8-a369c13e5cac

# Informations du duo à suivre
DUO_NAME=Loopy
DUO_TAG=EUW

# ID du canal Discord où envoyer les notifications
DISCORD_CHANNEL_ID=123456789012345678

# Intervalle de vérification en secondes (90 = recommandé pour éviter rate limit)
# Attention: L'API a des limites de taux (30 req/min pour Basic, 90 req/min pour Advanced)
# Avec 90 secondes, vous faites ~40 req/heure, ce qui est sûr même avec une Basic key
POLL_INTERVAL=90

# ID de l'utilisateur Discord à mentionner dans les notifications (optionnel)
# Pour obtenir votre ID: Mode développeur Discord → Clic droit sur vous → Copier l'ID
NOTIFY_USER_ID=265556280033148929

